{
  "name": "@maaamahahh/happy.js",
  "version": "0.4.0",
  "description": "Stabilizes object shapes, separates DOM layout reads from writes, auto-memos React components, batches DOM mutations, splits long tasks, and renders dense lists via WebGL with SDF text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maaamahahh/happy.js.git"
  },
  "homepage": "https://github.com/maaamahahh/happy.js#readme",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./babel": {
      "import": "./dist/babel.js",
      "require": "./dist/babel.js",
      "types": "./dist/babel.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./renderer": {
      "import": "./dist/renderer/index.js",
      "require": "./dist/renderer/index.js",
      "types": "./dist/renderer/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "performance",
    "optimization",
    "react",
    "v8",
    "hidden-class",
    "layout-thrashing",
    "dom-batching",
    "frontend",
    "babel-plugin",
    "vite-plugin"
  ],
  "license": "Unlicense",
  "dependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@chenglou/pretext": "^0.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-syntax-jsx": "^7.24.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "@babel/core": ">=7.0.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
